<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- windowSize -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="匹配窗口大小"
                android:textColor="#DD000000"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/val_window"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="5"
                android:textColor="#FF8C00"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="12"
            android:progress="2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="较小窗口响应更灵敏，较大窗口更稳定"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- searchForward -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="前向搜索范围"
                android:textColor="#DD000000"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/val_forward"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="60"
                android:textColor="#FF8C00"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_forward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90"
            android:progress="50" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="范围小防跳转，范围大方便追读跳过内容"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- searchBack -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="后向容差"
                android:textColor="#DD000000"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/val_back"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3"
                android:textColor="#FF8C00"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="允许匹配位置略早于当前位的字符数"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
