<?xml version="1.0" encoding="utf-8"?>
<!-- 同步设置页：服务器地址 + 访问 token -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0B"
    android:fitsSystemWindows="true">

    <!-- 导航栏 -->
    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/nav_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_back"
                android:tint="#A1A1A6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="返回"
                android:textColor="#A1A1A6"
                android:textSize="15sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nav_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="同步设置"
            android:textColor="#F5F5F7"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 占位，保持标题居中 -->
        <View
            android:layout_width="64dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务器地址"
                android:textColor="#A1A1A6"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:hint="https://xxx.trycloudflare.com"
                android:textColorHint="#636366"
                android:textColor="#F5F5F7"
                android:textSize="14sp"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="PC 端隧道地址或 http://&lt;局域网IP&gt;:3000"
                android:textColor="#636366"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="访问 token"
                android:textColor="#A1A1A6"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:hint="CC_MOBILE_TOKEN"
                android:textColorHint="#636366"
                android:textColor="#F5F5F7"
                android:textSize="14sp"
                android:inputType="textVisiblePassword"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="与 PC 端启动时的 CC_MOBILE_TOKEN 一致"
                android:textColor="#636366"
                android:textSize="11sp" />

            <!-- 测试连接结果 -->
            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#A1A1A6"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

            <!-- 按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <FrameLayout
                    android:id="@+id/btn_test"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_input">

                    <TextView
                        android:id="@+id/test_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="测试连接"
                        android:textColor="#F5F5F7"
                        android:textSize="15sp" />

                    <ProgressBar
                        android:id="@+id/test_progress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:indeterminateTint="#F5F5F7" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_save_button">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="保存"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="未改动时使用第三方口语稿 API 文档中的联调默认地址与 token。保存后写入本机；列表按更新时间最新在前，并会本地缓存。"
                android:textColor="#636366"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
