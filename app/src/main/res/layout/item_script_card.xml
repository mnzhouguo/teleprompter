<?xml version="1.0" encoding="utf-8"?>
<!-- 提词文稿卡片：左滑露出操作；点击查看 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clipChildren="true">

    <!-- 底层操作区 -->
    <LinearLayout
        android:id="@+id/card_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/action_edit"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:minHeight="132dp"
            android:gravity="center"
            android:text="编辑"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#636366"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/action_playback_ref"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:minHeight="132dp"
            android:gravity="center"
            android:text="转写"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#48484A"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/action_record"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:minHeight="132dp"
            android:gravity="center"
            android:text="录制"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#FF3B30"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/action_delete"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:minHeight="132dp"
            android:gravity="center"
            android:text="删除"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#FF453A"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 前景卡片 -->
    <LinearLayout
        android:id="@+id/script_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_script_card"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:minHeight="132dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="文稿标题"
                    android:textColor="#F5F5F7"
                    android:textSize="16sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/card_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~1分钟"
                    android:textColor="#636366"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="预览内容..."
                android:textColor="#A1A1A6"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.55"
                android:layout_marginTop="10dp"
                android:maxLines="5"
                android:minLines="3"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/card_char_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="156字"
                    android:textColor="#636366"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="#636366"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/card_created_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="今天"
                    android:textColor="#636366"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左滑操作"
                    android:textColor="#48484A"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
